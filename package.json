{
  "name": "sidekick-v2",
  "private": true,
  "version": "2.1.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:deps": "npm run build --workspace @sidekick/shared && npm run build --workspace @sidekick/billing",
    "typecheck": "npm run build:deps && npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run build:deps && npm run test --workspaces --if-present && npm run test:supabase",
    "test:supabase": "node scripts/validate-supabase-migrations.mjs",
    "test:e2e": "npm run build --workspaces --if-present && node --test tests/e2e/*.test.mjs",
    "build": "npm run build:deps && npm run build --workspaces --if-present",
    "chat:regen": "node scripts/regen-chat-webview-html.js"
  },
  "devDependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "allure-commandline": "^2.42.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-worklets": "0.7.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "react-native-worklets": "0.7.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "license": "MIT"
}
