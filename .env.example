# =============================================================================
# Delegent AI — server-side environment template
# =============================================================================
# IMPORTANT: every value below is a SECRET or a server-only setting.
# Never copy these into the mobile app and never prefix any of them with
# EXPO_PUBLIC_*. Anything Expo-prefixed gets inlined into the shipped app
# bundle and becomes public. Public values live in `.env.public.example`.
# -----------------------------------------------------------------------------

# TypeSafe workspace utility only, not deployed to the app. Source: Doppler prd.
TYPESAFE_API_KEY=

# Supabase (server-side; service role key has full DB access, DO NOT EXPOSE)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-side billing — secret key + webhook signing secret)
# Checkout route also needs SUPABASE_URL + SUPABASE_ANON_KEY to verify the
# signed-in user's bearer token. Webhook route needs SUPABASE_SERVICE_ROLE_KEY
# to write billing_events/subscription state. Use Stripe Price lookup keys in
# the dashboard; do not hardcode live price IDs here. SIDEKICK_CHECKOUT_REDIRECT_ORIGINS
# is a comma-separated allow-list of HTTPS origins allowed for Checkout success/cancel redirects.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SIDEKICK_CHECKOUT_REDIRECT_ORIGINS=

# Infrastructure providers (server-side automation only)
# Railway provisioning deploys the researched Hermes Agent Central Station template
# (`hermes-agent-ai`) through GraphQL templateDeployV2. Provide either a workspace
# for new projects or an existing project target; environment is optional.
RAILWAY_API_TOKEN=
RAILWAY_WORKSPACE_ID=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
HERMES_ADMIN_USERNAME=
HERMES_ADMIN_PASSWORD=
# Optional only if/when using a Sidekick-owned custom Hermes runner image.
SIDEKICK_RUNNER_IMAGE=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Model provider (server-side — Worker proxies to OpenRouter)
OPENROUTER_API_KEY=
SIDEKICK_WORKER_PROXY_ENABLED=true
SIDEKICK_USAGE_ENFORCEMENT_ENABLED=true

# Worker auth — shared secret used to sign per-user runner HMAC tokens.
# Required by the Worker; rotate by deploying a new value to all runners.
SIDEKICK_RUNNER_SHARED_SECRET=

# Worker Files links — optional HMAC key for short-lived app download URLs.
# If unset, the Worker falls back to SUPABASE_SERVICE_ROLE_KEY; production
# should prefer a separate value so file-link rotation does not rotate DB access.
SIDEKICK_FILE_LINK_SIGNING_SECRET=

# Worker deep health — bearer that unlocks the unredacted `/health?deep=1` body
# (provider names, error detail, remaining balance). Any random high-entropy
# string; it reads that one status body and nothing else. Unset means nobody is
# authorized, so the body stays redacted. Do NOT reuse SUPABASE_SERVICE_ROLE_KEY
# here: reading a diagnostic should never require the key to the whole database.
SIDEKICK_OPS_HEALTH_TOKEN=

# Migration aid only. Set to `true` to allow legacy unsigned runner tokens
# during the rollout of v1 HMAC tokens. Remove once every runner is updated.
# See SECURITY.md for the migration playbook.
SIDEKICK_RUNNER_AUTH_LEGACY=

# Worker proxy URL (server-side — provisioner injects it into the runner; never expose in mobile)
SIDEKICK_WORKER_PROXY_URL=

# Telegram ingress (server-side Worker route only)
# Set the Telegram bot webhook to https://<worker-host>/v1/telegram/webhook
# with the same X-Telegram-Bot-Api-Secret-Token value. Do not expose the bot
# token, webhook secret token, raw chat IDs, or connect-code hashes to mobile.
# The web/server connect-code endpoint also uses SUPABASE_ANON_KEY to verify
# the app user's bearer token and SUPABASE_SERVICE_ROLE_KEY to store only hashes.
SIDEKICK_TELEGRAM_BOT_USERNAME=
SIDEKICK_TELEGRAM_CONNECT_CODE_TTL_MINUTES=10
SIDEKICK_TELEGRAM_WEBHOOK_ENABLED=false
SIDEKICK_TELEGRAM_WEBHOOK_DRY_RUN_ENABLED=false
SIDEKICK_TELEGRAM_DRY_RUN_USER_ID=
SIDEKICK_TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Sentry observability (server-side / CI — never EXPO_PUBLIC_ and never in mobile)
# SENTRY_DSN: write-only ingest DSN for the delegent-backend (Worker) project.
# SENTRY_AUTH_TOKEN: management/CI token (the "Delegent Automation" internal
#   integration) for API management + source-map uploads. Treat as a secret.
# SENTRY_CLIENT_SECRET: OAuth client secret for that integration (not needed for
#   Bearer API calls; stored for completeness). SENTRY_ORG/SENTRY_REGION_URL
#   identify the EU-region org. Full runbook: docs/SENTRY.md.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_CLIENT_SECRET=
SENTRY_ORG=your-org
SENTRY_REGION_URL=https://de.sentry.io

# Auth email — Resend SMTP (the provider Supabase Auth relays sign-in / sign-up
# one-time-code emails through). RESEND_API_KEY is a SENDING-ONLY restricted key
# (least privilege; cannot manage domains) and doubles as the SMTP password
# (SMTP host smtp.resend.com, user "resend"). Free tier 3,000/mo. The sender must
# be on the verified domain delegentai.co.uk. NOT used in mobile. Full runbook:
# docs/AUTH_EMAIL.md.
RESEND_API_KEY=
