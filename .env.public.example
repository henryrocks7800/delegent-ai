# =============================================================================
# Delegent AI — public mobile environment template
# =============================================================================
# Every value in this file is intentionally public. EXPO_PUBLIC_* values are
# inlined into the shipped Android app bundle, so they must never carry server
# secrets, service-role keys, signing tokens, OAuth client secrets, bot tokens,
# webhook secrets, or any other credential. Server-only secrets live in
# `.env.example`.
#
# Real values belong in your local private public-env file (for example
# `~/.coworker-ai/live-provider.env`) or in your hosted deployment's mobile env
# config — never commit them here.
# -----------------------------------------------------------------------------

# Supabase public client config (anon key only, never service-role).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google native sign-in OAuth client IDs. Client *secrets* never belong here;
# only the public client IDs are needed by the installed mobile app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Public HTTPS origin of the Delegent AI web/API app. Mobile uses this to
# reach checkout, billing portal, runner files, and connect-code endpoints
# with the signed-in user's Supabase access token.
EXPO_PUBLIC_SIDEKICK_API_BASE_URL=

# Sentry crash/error monitoring DSN for the mobile app (delegent-mobile project).
# A DSN is a write-only ingest key: it can only send events, never read data or
# change the account, so it is safe to embed. The SDK is gated on this value, so
# leaving it blank simply disables crash reporting. See docs/SENTRY.md.
EXPO_PUBLIC_SENTRY_DSN=

# Google Analytics 4 measurement id for product funnel analytics (a G-XXXX id;
# public by nature - every gtag website embeds one). The tracker is gated on
# this value, so leaving it blank disables analytics entirely. See
# apps/mobile/src/analytics/.
EXPO_PUBLIC_GA4_MEASUREMENT_ID=
