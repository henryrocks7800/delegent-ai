{
  "name": "@sidekick/webapp",
  "private": true,
  "version": "1.2.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/write-public-env.mjs && node scripts/sync-chat-webview.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "typecheck": "tsc --noEmit",
    "test": "npm --prefix ../.. run build --workspace @sidekick/shared && node scripts/sync-chat-webview.mjs && node --test test/*.test.mjs",
    "audit": "node test/browser/audit.mjs"
  },
  "dependencies": {
    "@sidekick/shared": "1.2.6",
    "@supabase/supabase-js": "^2.105.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
