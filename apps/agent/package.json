{
  "name": "@sidekick/agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The coworker engine for accounts on the agent engine: Cloudflare Project Think with Composio connections, reached only through the production Worker's service binding.",
  "scripts": {
    "types": "wrangler types --strict-vars=false worker-configuration.d.ts",
    "typecheck": "wrangler types --strict-vars=false worker-configuration.d.ts && tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/codemode": "0.5.2",
    "@cloudflare/puppeteer": "1.4.0",
    "@cloudflare/think": "0.18.0",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "agents": "0.23.0",
    "ai": "7.0.100",
    "airport-data-js": "4.0.0",
    "geolib": "3.3.14",
    "imapflow": "2.0.7",
    "postal-mime": "3.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "6.0.3",
    "wrangler": "4.131.2"
  }
}
