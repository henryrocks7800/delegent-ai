{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": false,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production"
    },
    "ios-simulator": {
      "distribution": "internal",
      "channel": "preview-ios",
      "environment": "production",
      "ios": {
        "simulator": true
      }
    },
    "ios-device": {
      "distribution": "internal",
      "channel": "preview-ios",
      "ios": {
        "simulator": false
      }
    },
    "production-ios": {
      "extends": "production",
      "credentialsSource": "local",
      "ios": {
        "resourceClass": "medium",
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_IOS_PURCHASE_MODE": "iap",
        "DELEGENT_IOS_STORE_VERSION": "2.7.2"
      }
    },
    "internal": {
      "extends": "production",
      "channel": "internal",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "../../.secrets/play-service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascAppId": "YOUR_ASC_APP_ID",
        "ascApiKeyPath": "./ios-credentials/asc-key.p8",
        "ascApiKeyId": "YOUR_ASC_KEY_ID",
        "ascApiKeyIssuerId": "YOUR_ASC_ISSUER_ID"
      }
    },
    "production-ios": {
      "extends": "production"
    }
  }
}
