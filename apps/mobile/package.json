  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    },
    "autolinking": {
      "apple": {
        "exclude": [
          "expo-av"
        ]
      }
    },
    "install": {
      "exclude": [
        "@sentry/react-native",
        "expo-document-picker",
        "react-native"
      ]
