        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF7"
      },
      "googleServicesFile": "./google-services.json",
      "versionCode": 55
    },
    "extra": {
      "eas": {
        "projectId": "814ee5d5-c8d8-44c2-93b0-932e898eabd8"
      }
    },
    "owner": "delegentai",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2C4A38"
        }
      ]
    ]
  }
